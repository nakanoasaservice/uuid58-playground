{
  "name": "uuid58-playground",
  "description": "Playground for uuid58",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "qwik build",
    "build.client": "vite build",
    "build.preview": "vite build --ssr src/entry.preview.tsx",
    "build.server": "vite build -c adapters/ssg/vite.config.ts",
    "build.types": "tsc --incremental --noEmit",
    "deploy": "echo 'Run \"npm run qwik add\" to install a server adapter'",
    "dev": "vite --mode ssr",
    "dev.debug": "bun --inspect-brk ./node_modules/vite/bin/vite.js --mode ssr --force",
    "fmt": "prettier --write .",
    "fmt.check": "prettier --check .",
    "lint": "eslint \"src/**/*.ts*\"",
    "preview": "qwik build preview && vite preview --open",
    "start": "vite --open --mode ssr",
    "qwik": "qwik"
  },
  "dependencies": {
    "@nakanoaas/uuid58": "^1.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@qwik.dev/core": "2.0.0-rc.2",
    "@qwik.dev/router": "2.0.0-rc.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "24.13.3",
    "eslint": "9.39.5",
    "eslint-plugin-qwik": "2.0.0-rc.2",
    "globals": "16.5.0",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "undici": "^7.29.0",
    "vite": "8.3.3",
    "vite-tsconfig-paths": "^4.3.2"
  },
  "engines": {
    "bun": "^1.4.0"
  },
  "trustedDependencies": [
    "@tailwindcss/oxide",
    "esbuild",
    "sharp"
  ]
}
